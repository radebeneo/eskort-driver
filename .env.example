# Copy to .env and fill in. .env is gitignored. Never commit real values.
#
# Every EXPO_PUBLIC_* value is inlined into the app bundle and readable by anyone
# with the app. Only client-safe values belong here. Server secrets
# (Supabase secret/service-role key, Google Maps API key) must be stored as
# Supabase Edge Function secrets, never in this file.

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# true = fictional in-memory data, no backend needed (rejected in production).
EXPO_PUBLIC_USE_MOCKS=true

# Supabase project URL and publishable (anon) key: Project Settings > API.
# Required when EXPO_PUBLIC_USE_MOCKS=false.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Name of the Supabase Edge Function that proxies Google routing, distance matrix and places.
EXPO_PUBLIC_GOOGLE_MAPS_FUNCTION=google-maps
